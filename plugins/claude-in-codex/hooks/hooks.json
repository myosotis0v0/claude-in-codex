{
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume",
      "hooks": [{
        "type": "command",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/companion.ps1') -Action AutoStart\"",
        "timeout": 10,
        "statusMessage": "Starting Claude corner launcher"
      }]
    }],
    "UserPromptSubmit": [{"hooks": [{
      "type": "command",
      "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/task-event.ps1')\"",
      "timeout": 3
    }]}],
    "PreCompact": [{"hooks": [{
      "type": "command",
      "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/task-event.ps1')\"",
      "timeout": 3
    }]}],
    "PostCompact": [{"hooks": [{
      "type": "command",
      "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/task-event.ps1')\"",
      "timeout": 3
    }]}],
    "SubagentStart": [{"hooks": [{
      "type": "command",
      "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/task-event.ps1')\"",
      "timeout": 3
    }]}],
    "SubagentStop": [{"hooks": [{
      "type": "command",
      "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/task-event.ps1')\"",
      "timeout": 3
    }]}],
    "Stop": [{"hooks": [{
      "type": "command",
      "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/task-event.ps1')\"",
      "timeout": 3
    }]}],
    "Interrupt": [{"hooks": [{
      "type": "command",
      "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/task-event.ps1')\"",
      "timeout": 3
    }]}],
    "SessionEnd": [{"hooks": [{
      "type": "command",
      "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"& (Join-Path $env:PLUGIN_ROOT 'scripts/task-event.ps1')\"",
      "timeout": 3
    }]}]
  }
}
